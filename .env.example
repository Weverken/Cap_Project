# Copy this file to .env and fill in your actual values.
# Never commit the real .env file.

# --- Database ---
# Postgres connection string from Supabase or Neon (free tier).
# Use the "Session pooler" string from Supabase, not the Project URL.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# --- Gemini API ---
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# Used by the chat agent, recipe importer (image/URL), and the Discover Recipes web search feature.
GOOGLE_API_KEY=

# --- Langfuse (AI observability/tracing) ---
# Get keys from your Langfuse project settings: https://cloud.langfuse.com
# If these are left blank, the app still runs, it just won't trace
# Gemini calls (see src/observability.py).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional overrides (see src/config.py for defaults) ---
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TEMPERATURE=0.7